{
  "name": "ladybird-bot",
  "version": "0.1.0",
  "description": "Ladybird Discord Bot",
  "license": "BSD-2-Clause",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint-and-fix": "eslint . --ext .ts --fix",
    "start:dev": "bun --watch ./src/index.ts",
    "start": "bun ./src/index.ts",
    "test": "bun test",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LadybirdBrowser/discord-bot.git"
  },
  "keywords": [
    "discord",
    "typescript",
    "bot",
    "ladybird",
    "serenityos"
  ],
  "bugs": {
    "url": "https://github.com/LadybirdBrowser/discord-bot/issues"
  },
  "homepage": "https://github.com/LadybirdBrowser/discord-bot#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.17.0",
    "discord.js": "^14.26.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "flatted": "^3.4.0",
    "ws": "^8.20.1"
  }
}
